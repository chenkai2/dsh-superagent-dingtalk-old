{
  "name": "@chenkai114/dsh-superagent-dingtalk",
  "author": "chenkai2",
  "license": "MIT",
  "version": "0.0.1",
  "description": "DingTalk source for dsh-superagent: reads configured groups through the official dws CLI, receives messages addressed to an application robot over Stream, and replies as a bot.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./dingtalk-watch": "./lib/dingtalk-watch.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:ci": "vitest run",
    "prepublishOnly": "node -e \"const ci=process.env.GITHUB_ACTIONS;const dry=String(process.env.npm_config_dry_run||'')==='true';const boot=process.env.ALLOW_FIRST_PUBLISH==='1';if(ci)process.exit(0);if(dry)process.exit(0);if(boot){console.warn('\\\\n[首次发布] 允许本地发布一次：npm 上还没有这个包，Trusted Publisher 无处可配。');console.warn('  发完立刻去包设置里配 Trusted Publisher，之后只走 GitHub Release。\\\\n');process.exit(0);}console.error('\\\\n[拒绝发布] 本包只通过 GitHub Release + npm Trusted Publishing 发布。');console.error('  首次上架例外：ALLOW_FIRST_PUBLISH=1 npm publish --access public');console.error('  其余情况：升版本 → 提交 → 发 GitHub Release（tag=v<version>）→ 等 Actions 完成。\\\\n');process.exit(1)\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3",
    "dingtalk-stream": "2.1.6-beta.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-alpha.2",
